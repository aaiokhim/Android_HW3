<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout_a"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <Button
        android:id="@+id/btn_to_b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open ActivityB"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/color_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Input color, for example: #FF0000"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btn_generate_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate color"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/show_color"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:text="Show color"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

</LinearLayout>